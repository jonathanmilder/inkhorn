# ---- Postgres (Neon) ----
# The server reads DATABASE_URL and nothing else. It never chooses a database.
# Locally: the dev branch. On Render: dev now, main at cutover (step 17).
#
# THE sslmode BELOW DOES NOT GOVERN OUR OWN PROGRAMS (Q18, amendment 3).
# server/src/db-config.ts strips the TLS parameters out of the string and hands pg an
# explicit `ssl` object instead, because pg parses the string LAST and an intact
# sslmode replaces whatever ssl setting the code asked for. So for this server and the
# loader, TLS is decided in code, not here.
# Keep sslmode in the string anyway: psql and GUI clients read the string directly, and
# for them it is the only thing that governs the connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full

# ---- Loader targets (local only — never set these on Render) ----
# server/scripts/import-json.ts takes --target dev|main and reads one of these.
# No default. Choosing a database is something you do out loud, on the command line.
DATABASE_URL_DEV=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
DATABASE_URL_MAIN=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full

# ---- Single-user placeholder (24i) ----
# The id of the one seeded users row. Deleted in leg two.
DEFAULT_USER_ID=1

# ---- Anthropic (step 16) ----
ANTHROPIC_API_KEY=

# ---- Temporary access gate (20d) ----
# Required on Render: the server refuses to start without both. Locally, leave
# both empty and the gate is off (the server says so at boot). Never set just one.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---- Server ----
# Render sets PORT itself. Locally, the server falls back to 3000 if unset.
PORT=3000
